---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

// Accuracy notes: PRD §5 — do not simplify these into being wrong.
const regs = [
  {
    name: 'NIS2',
    status: 'In force · varies by country',
    live: true,
    line: 'Significant incidents run on a clock: an early warning within 24 hours, a notification within 72 hours, and a report within a month. Your records need to support each step, and the details differ by country.',
  },
  {
    name: 'DORA',
    status: 'Applies since Jan 2025',
    live: true,
    line: 'Financial entities have to keep operating when a third-party provider fails, and be able to show how they do it.',
  },
  {
    name: 'GDPR',
    status: 'In force since 2018',
    live: true,
    line: 'Most companies have the policies in place. The harder part is making sure the systems actually do what those policies say.',
  },
  {
    name: 'EU AI Act',
    status: 'High-risk: Dec 2027',
    live: false,
    line: 'Obligations for high-risk systems start in December 2027. Starting now gives you time to prepare calmly rather than in a rush.',
  },
];
---

<Base
  title="The regulations, without the fear-mongering"
  description="Accurate, current status of NIS2, DORA, GDPR and the EU AI Act — what applies to you, and when."
>
  <section>
    <div class="wrap col">
      <span class="eyebrow">Know your deadlines</span>
      <h2>Where each regulation stands today</h2>
      <p class="lede">
        A lot of what's written about these rules is designed to scare you. This is the
        plain version: what applies, and from when.
      </p>
      <ul class="list">
        {regs.map((r) => (
          <li class="row">
            <h3>{r.name}</h3>
            <span class={`status ${r.live ? 'live' : 'soon'}`}>{r.status}</span>
            <p>{r.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .col { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  .lede { margin-bottom: 30px; }
  .list { list-style: none; display: flex; flex-direction: column; gap: 12px; align-self: stretch; }
  .row {
    display: grid; grid-template-columns: 150px 200px 1fr; gap: 20px; align-items: center;
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 22px 28px; text-align: left;
  }
  .row h3 { font-size: 17px; }
  .status { font-size: 11.5px; letter-spacing: 0.05em; padding: 5px 12px; border-radius: 999px; white-space: nowrap; text-align: center; font-weight: 600; }
  .status.live { background: rgba(47, 158, 110, 0.16); color: #7fd3a8; }
  .status.soon { background: var(--amber-soft); color: var(--amber); }
  .row p { font-size: 15px; color: var(--muted); }
  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr auto; }
    .row p { grid-column: 1 / -1; }
  }
</style>
