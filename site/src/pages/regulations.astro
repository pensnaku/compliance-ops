---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

// Accuracy notes: PRD §5 — do not simplify these into being wrong.
const regs = [
  {
    name: 'NIS2',
    status: 'In force · varies by country',
    live: true,
    line: 'Incident clock: 24-hour early warning → 72-hour notification → one-month report. Your records have to support it.',
  },
  {
    name: 'DORA',
    status: 'Applies since Jan 2025',
    live: true,
    line: 'Financial entities must stay operational through third-party failures — and be able to prove it.',
  },
  {
    name: 'GDPR',
    status: 'In force since 2018',
    live: true,
    line: 'Your policies promise it. Your systems have to deliver it. That last mile is where most programmes quietly fail.',
  },
  {
    name: 'EU AI Act',
    status: 'High-risk: Dec 2027',
    live: false,
    line: 'High-risk obligations start December 2027 — now is the affordable moment to get ready, before the rush.',
  },
];
---

<Base
  title="The regulations, without the fear-mongering"
  description="Accurate, current status of NIS2, DORA, GDPR and the EU AI Act — what applies to you, and when."
>
  <section>
    <div class="wrap col">
      <span class="eyebrow">Know your deadlines</span>
      <h2>Without the fear-mongering</h2>
      <ul class="list">
        {regs.map((r) => (
          <li class="row">
            <h3>{r.name}</h3>
            <span class={`status ${r.live ? 'live' : 'soon'}`}>{r.status}</span>
            <p>{r.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .col { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  h2 { margin-bottom: 22px; }
  .list { list-style: none; display: flex; flex-direction: column; gap: 12px; align-self: stretch; }
  .row {
    display: grid; grid-template-columns: 150px 200px 1fr; gap: 20px; align-items: center;
    background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 22px 28px; text-align: left;
  }
  .row h3 { font-size: 17px; }
  .status { font-size: 11.5px; letter-spacing: 0.05em; padding: 5px 12px; border-radius: 999px; white-space: nowrap; text-align: center; font-weight: 600; }
  .status.live { background: #dcf5e7; color: #15803d; }
  .status.soon { background: var(--amber-soft); color: var(--amber); }
  .row p { font-size: 15px; color: var(--muted); }
  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr auto; }
    .row p { grid-column: 1 / -1; }
  }
</style>
