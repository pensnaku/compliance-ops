---
import { BOOKING_URL } from '../config.ts';
---

<section class="cta">
  <div class="wrap col">
    <span class="eyebrow soft">Straight answers — no sales pitch</span>
    <h2>Bring us a finding.<br /><span class="accent soft-accent">We'll tell you how we'd fix it.</span></h2>
    <p>Thirty minutes with the person who would actually do the work.</p>
    <a class="btn light ph" href={BOOKING_URL}>Book a call</a>
  </div>
</section>

<style>
  .cta { background: var(--dark); padding: 100px 0; }
  .col { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .eyebrow.soft { color: var(--green-soft); }
  h2 { color: #fff; font-size: clamp(32px, 3.8vw, 44px); }
  .soft-accent { color: var(--green-soft); }
  p { font-size: 16px; color: #9aa7b5; }
  .btn { margin-top: 10px; }
</style>
