---
const steps = [
  'Read-only discovery',
  'A plan you approve first',
  'Built away from your live systems',
  'Your team reviews and approves',
  'Evidence handed over',
];
const guarantees = [
  'No standing access to your systems',
  'Everything we do is logged',
  'Every change reversible',
  'You own everything we build',
];
---

<section id="how-we-work">
  <div class="wrap col">
    <span class="eyebrow">The part nobody else publishes</span>
    <h2>How we work in your environment</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="serif num">{i + 1}</span>
          <span class="label">{s}</span>
        </li>
      ))}
    </ol>
    <ul class="pills">
      {guarantees.map((g) => <li>{g}</li>)}
    </ul>
    <p class="ai-line">AI drafts the work. <span class="accent">A named specialist signs it.</span></p>
    <p class="ai-sub">That's why sprints take weeks, not quarters.</p>
  </div>
</section>

<style>
  .col { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  h2 { margin-bottom: 22px; }
  .steps { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; align-self: stretch; }
  .step { border: 1px solid var(--line); border-radius: 16px; padding: 26px 18px; background: #fff; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .num { font-size: 22px; font-style: italic; color: var(--green); }
  .label { font-size: 15px; font-weight: 600; }
  .pills { list-style: none; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 20px; }
  .pills li { font-size: 14px; color: #4d6a5f; border: 1px solid #d8e4dd; background: #fff; border-radius: 999px; padding: 9px 20px; }
  .ai-line { font-size: 26px; font-weight: 500; margin-top: 28px; letter-spacing: -0.01em; }
  .ai-sub { font-size: 15px; color: var(--faint); }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .steps { grid-template-columns: 1fr; } }
</style>
