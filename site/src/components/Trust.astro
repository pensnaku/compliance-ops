---
const items = [
  { label: 'ISO 27001', caption: 'certification in progress', pending: true },
  { label: 'Indemnity and cyber insurance', caption: 'certificate on request', pending: false },
  { label: 'Data processing agreement', caption: 'with SCCs where applicable', pending: false },
  { label: 'Sub-processor list', caption: 'short and published', pending: false },
  { label: 'Responsible disclosure', caption: 'security.txt published', pending: false },
  { label: 'EU entity, EU data only', caption: 'registered in the Netherlands', pending: false },
];
---

<section class="band" id="trust">
  <div class="wrap col">
    <span class="eyebrow">Our own compliance</span>
    <h2>We hold ourselves to the same standard</h2>
    <p class="lede">
      If we ask for your evidence, you should see ours. Here's where we stand today.
    </p>
    <ul class="grid">
      {items.map((t) => (
        <li class="t-card">
          <span class={`dot ${t.pending ? 'amber' : 'green'}`} aria-hidden="true"></span>
          <div>
            <strong>{t.label}</strong>
            <span>{t.caption}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .col { display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  .lede { margin-bottom: 30px; }
  .grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-self: stretch; text-align: left; }
  .t-card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 20px 24px; display: flex; align-items: center; gap: 14px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .dot.green { background: #2f9e6e; }
  .dot.amber { background: #d9a441; }
  .t-card div { display: flex; flex-direction: column; gap: 1px; }
  .t-card strong { font-size: 15px; font-weight: 600; }
  .t-card span { font-size: 12.5px; color: var(--faint); }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
